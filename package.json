{
  "name": "harness-relay",
  "private": true,
  "description": "A local group chat for the real Claude Code, Codex and Grok CLIs: give each a role, choose how they take turns, and they work on your code, or any question, and answer each other.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch --clear-screen=false src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "login": "tsx scripts/login.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "site:preview": "tsx scripts/preview-site.ts",
    "icons": "tsx scripts/app-icons.ts",
    "demo": "tsx scripts/demo/index.ts",
    "desktop": "npm run build && npm --prefix desktop run build && npm --prefix desktop start",
    "desktop:dist": "npm run build && npm --prefix desktop run build && npm --prefix desktop run dist --",
    "desktop:typecheck": "npm --prefix desktop run typecheck",
    "release:next": "tsx scripts/release.ts next --remote",
    "release:check": "tsx scripts/release.ts check"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@napi-rs/keyring": "^2.1.2",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.17",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "^12.2.0",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
