{
  "provider": "copilot",
  "version": "1.0.109",
  "shapes": {
    "probe": {
      "kinds": {
        "from-cli account.getCurrentAuth result": [
          "id:number",
          "jsonrpc:string",
          "result:{}"
        ],
        "from-cli account.getQuota error": [
          "error.code:number",
          "error.message:string",
          "id:number",
          "jsonrpc:string"
        ],
        "from-cli connect result": [
          "id:number",
          "jsonrpc:string",
          "result.ok:boolean",
          "result.protocolVersion:number",
          "result.taskKinds[]:string",
          "result.version:string"
        ],
        "from-cli initialize result": [
          "id:number",
          "jsonrpc:string",
          "result.agentCapabilities.auth.logout:{}",
          "result.agentCapabilities.loadSession:boolean",
          "result.agentCapabilities.mcpCapabilities.http:boolean",
          "result.agentCapabilities.mcpCapabilities.sse:boolean",
          "result.agentCapabilities.promptCapabilities.audio:boolean",
          "result.agentCapabilities.promptCapabilities.embeddedContext:boolean",
          "result.agentCapabilities.promptCapabilities.image:boolean",
          "result.agentCapabilities.sessionCapabilities.close:{}",
          "result.agentCapabilities.sessionCapabilities.list:{}",
          "result.agentInfo.name=Copilot",
          "result.agentInfo.title:string",
          "result.agentInfo.version:string",
          "result.authMethods[]._meta.terminal-auth.args[]:string",
          "result.authMethods[]._meta.terminal-auth.command:string",
          "result.authMethods[]._meta.terminal-auth.label:string",
          "result.authMethods[].description:string",
          "result.authMethods[].id:string",
          "result.authMethods[].name:string",
          "result.protocolVersion:number"
        ],
        "from-cli session/new error": [
          "error.code:number",
          "error.message:string",
          "id:number",
          "jsonrpc:string"
        ],
        "to-cli account.getCurrentAuth": [
          "id:number",
          "jsonrpc:string",
          "method=account.getCurrentAuth",
          "params:{}"
        ],
        "to-cli account.getQuota": [
          "id:number",
          "jsonrpc:string",
          "method=account.getQuota",
          "params:{}"
        ],
        "to-cli connect": [
          "id:number",
          "jsonrpc:string",
          "method=connect",
          "params:{}"
        ],
        "to-cli initialize": [
          "id:number",
          "jsonrpc:string",
          "method=initialize",
          "params.clientCapabilities:{}",
          "params.protocolVersion:number"
        ],
        "to-cli session/new": [
          "id:number",
          "jsonrpc:string",
          "method=session/new",
          "params.cwd:string",
          "params.mcpServers:[]"
        ]
      },
      "flags": [
        "--acp",
        "--add-dir",
        "--add-github-mcp-tool",
        "--add-github-mcp-toolset",
        "--additional-mcp-config",
        "--agent",
        "--allow-all",
        "--allow-all-mcp-server-instructions",
        "--allow-all-paths",
        "--allow-all-tools",
        "--allow-all-urls",
        "--allow-tool",
        "--allow-url",
        "--assisted-approval",
        "--attachment",
        "--auto-tier",
        "--autopilot",
        "--available-tools",
        "--banner",
        "--bash-env",
        "--connect",
        "--context",
        "--continue",
        "--deny-tool",
        "--deny-url",
        "--disable-builtin-mcps",
        "--disable-client-telemetry",
        "--disable-mcp-server",
        "--disallow-temp-dir",
        "--dynamic-retrieval",
        "--enable-all-github-mcp-tools",
        "--enable-mcp-server",
        "--enable-memory",
        "--excluded-tools",
        "--experimental",
        "--extension-sdk-path",
        "--fleet",
        "--help",
        "--interactive",
        "--log-dir",
        "--log-level",
        "--max-ai-credits",
        "--max-autopilot-continues",
        "--mcp-github-auth",
        "--mode",
        "--model",
        "--mouse",
        "--name",
        "--no-ask-user",
        "--no-auto-update",
        "--no-bash-env",
        "--no-color",
        "--no-custom-instructions",
        "--no-eager-powershell-resolution",
        "--no-experimental",
        "--no-mouse",
        "--output-format",
        "--plain-diff",
        "--plan",
        "--plugin-dir",
        "--prompt",
        "--reasoning-effort",
        "--resume",
        "--screen-reader",
        "--secret-env-vars",
        "--session-id",
        "--share",
        "--share-gist",
        "--silent",
        "--stream",
        "--sync-session",
        "--trust-folder",
        "--usage-output-file",
        "--version",
        "--yolo"
      ],
      "results": {
        "status": [
          "accounts[].auth.loggedIn:boolean",
          "accounts[].id:string",
          "accounts[].label:string",
          "accounts[].usingStoredApiKey:boolean",
          "auth.loggedIn:boolean",
          "bin:string",
          "fact:installed=true",
          "fact:loggedIn=false",
          "fact:version=read",
          "installed:boolean",
          "provider:string",
          "usingStoredApiKey:boolean",
          "version:string"
        ],
        "models": [
          "efforts[]:string",
          "error:string",
          "fact:error=yes",
          "fact:models=none",
          "fact:source=builtin",
          "models:[]",
          "provider:string",
          "source:string"
        ],
        "usage": [
          "account:string",
          "fact:error=no",
          "fact:none=signedOut",
          "fact:problem=-",
          "limits:[]",
          "none:string",
          "provider:string"
        ],
        "native": [
          "agents:[]",
          "asRun:boolean",
          "cwd:string",
          "hooks:[]",
          "mcpServers[].id:string",
          "mcpServers[].name=computer-use",
          "mcpServers[].source:string",
          "mcpServers[].transport:string",
          "memory:[]",
          "memoryFromFiles:boolean",
          "nativeItems:{}",
          "nativeOff:[]",
          "plugins[].enabled:boolean",
          "plugins[].name=browser-use",
          "plugins[].name=computer-use",
          "plugins[].source:string",
          "problems:[]",
          "provider:string",
          "skills[].description:string",
          "skills[].id:string",
          "skills[].name=customize-cloud-agent",
          "skills[].name=github-pr-media",
          "skills[].name=pr-stack",
          "skills[].path:string",
          "skills[].source:string"
        ]
      }
    }
  }
}
