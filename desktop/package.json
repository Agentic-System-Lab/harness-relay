  "description": "The Harness Relay desktop app: runs the server in the background, with an icon in the menu bar or system tray, and shows the chat in a window of its own.",
  "license": "SUL-1.0",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "start": "electron build/app",
    "dist": "tsx scripts/dist.ts",
    "typecheck": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "prettier": "3.10.1"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.6"
  }
}
